rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Shops collection - readable by authenticated users
    match /shops/{shopId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (request.auth.token.role == 'admin' || request.auth.uid == shopId);
    }
    
    // Requests collection with role-based access
    match /requests/{requestId} {
      allow read: if request.auth != null && 
        (
          // Admin can read all requests
          request.auth.token.role == 'admin' ||
          // Shop users can only read their own requests
          resource.data.shopId == request.auth.token.shopId
        );
      
      allow create, update: if request.auth != null && 
        (
          // Admin can create/update any request
          request.auth.token.role == 'admin' ||
          // Shop users can only create/update their own requests
          request.resource.data.shopId == request.auth.token.shopId
        ) &&
        // Ensure the request data is valid
        request.resource.data.keys().hasAll(['shopId', 'date', 'items', 'submitted', 'createdAt']) &&
        request.resource.data.shopId is string &&
        request.resource.data.date is string &&
        request.resource.data.items is list &&
        request.resource.data.submitted is bool;
      
      allow delete: if request.auth != null && 
        request.auth.token.role == 'admin';
    }
    
    // Items collection (optional reference data)
    match /items/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}